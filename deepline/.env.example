# Deepline Cold Outbound Skills - Environment Variables
# Copy to .env.deepline and fill in your API keys
# Add .env.deepline to .gitignore (never commit secrets)

# ============================================================================
# DEEPLINE (Required)
# ============================================================================
DEEPLINE_API_KEY=your_deepline_api_key

# ============================================================================
# SENDING PLATFORM (Choose one)
# ============================================================================
# Lemlist (primary for Deepline users)
LEMLIST_API_KEY=your_lemlist_api_key

# Smartlead (optional - if migrating from Smartlead)
# SMARTLEAD_API_KEY=your_smartlead_key

# Instantly (optional - if using Instantly instead)
# INSTANTLY_API_KEY=your_instantly_key

# ============================================================================
# LIST BUILDING (Bring your own keys)
# ============================================================================
# Prospeo - Person/company search (title-first)
PROSPEO_API_KEY=your_prospeo_key

# Blitz - Domain-to-contacts lookup
BLITZ_API_KEY=your_blitz_key

# RapidAPI - Google Maps, LinkedIn data
RAPIDAPI_KEY=your_rapidapi_key

# ============================================================================
# CRM / CUSTOMER DB
# ============================================================================
# HubSpot - CRM truth for Deepline Customer DB
HUBSPOT_API_KEY=your_hubspot_key

# ============================================================================
# ENRICHMENT (Optional)
# ============================================================================
# OpenRouter - AI company analysis enrichment
OPENROUTER_API_KEY=your_openrouter_key

# OpenWebNinja - Company news enrichment
OPENWEBNINJA_KEY=your_openwebninja_key

# BuiltWith - Tech stack detection
BUILTWITH_API_KEY=your_builtwith_key

# ============================================================================
# DOMAIN & INBOX PROVISIONING
# ============================================================================
# Dynadot - Buy .com/.co domains
DYNADOT_API_KEY=your_dynadot_key

# Zapmail - Create inboxes
ZAPMAIL_API_KEY=your_zapmail_key

# ============================================================================
# SENDER SIGNATURE DEFAULTS
# ============================================================================
SENDER_FIRST_NAME="Jane"
SENDER_LAST_NAME="Smith"
SENDER_TITLE="Founder"
SENDER_COMPANY_NAME="Acme Inc"
SENDER_PHYSICAL_ADDRESS="123 Main St, Suite 400, Austin, TX 78701"

# ============================================================================
# LEMLIST SPECIFIC (if using Lemlist)
# ============================================================================
# Lemlist warmup settings
LEMLIST_WARMUP_MAX_PER_DAY=40
LEMLIST_WARMUP_DAILY_RAMPUP=5
LEMLIST_WARMUP_REPLY_RATE=20

# ============================================================================
# DEEPLINE PLAYS SETTINGS
# ============================================================================
# Default model for deeplineagent (optional - uses Deepline default if not set)
# DEEPLINE_DEFAULT_MODEL=gpt-4o-mini

# Max credits per play run (optional - prevents runaway costs)
# DEEPLINE_MAX_CREDITS_PER_RUN=100

# ============================================================================
# OPTIONAL: CLAY (if using Clay alongside Deepline)
# ============================================================================
# Clay cookie for API calls (only if extracting from Clay tables)
# CLAY_COOKIE='your_clay_cookie_here_in_single_quotes'
# CLAY_VERSION=v20260311_192407Z_5025845142

# ============================================================================
# NOTES
# ============================================================================
# Minimum viable setup for first campaign:
#   - DEEPLINE_API_KEY
#   - LEMLIST_API_KEY
#   - PROSPEO_API_KEY
#   - DYNADOT_API_KEY
#   - ZAPMAIL_API_KEY
#
# Add more as you scale:
#   - HUBSPOT_API_KEY (for CRM truth)
#   - BLITZ_API_KEY (for domain-first list building)
#   - RAPIDAPI_KEY (for LinkedIn/Google Maps data)
#
# Cost expectations (first campaign, 2,000 leads, 20 domains, 40 inboxes):
#   - Domains: ~$240 one-time (20 × $12 .com)
#   - Zapmail: ~$60/mo (40 inboxes)
#   - Lemlist: ~$59/mo (starter plan)
#   - Prospeo: ~$20 (2,000-lead export)
#   - Deepline credits: ~$10-30 (depends on enrichment depth)
#   - Total Month 1: ~$390-420
#   - Recurring: ~$120-150/mo
